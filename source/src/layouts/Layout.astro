---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Palette from "../components/Palette.astro";
import Preloader from "../components/Preloader.astro";
import { profile } from "../data/site.js";
const { title = `${profile.name} — ${profile.role.en}` } = Astro.props;
const description = profile.intro.en;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="th" data-lang="th" data-theme="dark" data-email={profile.email} data-github={profile.handle} data-tz={profile.timezone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#07090d" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300..800&family=Kanit:wght@300;500;600;700&family=Geist:wght@400..600&family=JetBrains+Mono:wght@400;500;600&family=IBM+Plex+Sans+Thai:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var d = document.documentElement, s = {};
        try { s.t = localStorage.getItem("theme"); s.l = localStorage.getItem("lang"); } catch (e) {}
        d.dataset.theme = s.t || "dark";
        var l = s.l || ((navigator.language || "").toLowerCase().startsWith("th") ? "th" : "en");
        d.dataset.lang = l; d.lang = l;
      })();
    </script>
  </head>
  <body>
    <Preloader />
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"><span></span></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <Nav />
    <main>
      <slot />
    </main>
    <Palette />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
