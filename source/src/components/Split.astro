---
// Splits text into words, then graphemes (safe for Thai combining marks),
// so each character can animate in. Thai has no spaces, so words come from
// Intl.Segmenter. Screen readers get the plain text via aria-label.
const { text, class: cls = "", delay = 0, as: Tag = "span" } = Astro.props;
const words = new Intl.Segmenter("th", { granularity: "word" });
const graphemes = new Intl.Segmenter("th", { granularity: "grapheme" });
let i = 0;
const parts = [...words.segment(String(text))].map((w) =>
  /^\s+$/.test(w.segment) ? null : [...graphemes.segment(w.segment)].map((g) => ({ g: g.segment, i: i++ }))
);
---
<Tag class={`split ${cls}`} style={`--d:${delay}ms`} aria-label={text}>
  {parts.map((chars) =>
    chars === null ? " " : <span class="w" aria-hidden="true">{chars.map((c) => <span class="ch" style={`--i:${c.i}`}>{c.g}</span>)}</span>
  )}
</Tag>
