---
import T from "./T.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects, profile } from "../data/site.js";
---
<section id="work" data-rail class="relative">
  <div class="sticky top-0 flex h-[100svh] flex-col overflow-hidden pt-24 pb-8">
    <div class="mx-auto flex w-full max-w-[1400px] items-end justify-between gap-6 px-6 sm:px-10">
      <div>
        <p class="label mb-4 flex items-center gap-4"><span class="h-px w-10 bg-beak"></span>II — <T th="ผลงานที่คัดมา" en="Selected work" /></p>
        <h2 class="display text-[clamp(2rem,4.2vw,3.8rem)]"><T th="ของที่สร้างไว้" en="Things I've shipped" /></h2>
      </div>
      <div class="hidden text-right sm:block">
        <div class="font-display text-4xl font-bold tabular-nums tracking-tight"><span data-rail-count>01</span><span class="text-muted"> / {String(projects.length).padStart(2, "0")}</span></div>
        <div class="label mt-2"><T th="เลื่อนลงเพื่อดูต่อ →" en="Keep scrolling →" /></div>
      </div>
    </div>
    <div class="mx-auto mt-6 h-px w-full max-w-[1400px] px-6 sm:px-10"><div class="relative h-px bg-line"><div data-rail-bar class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-beak"></div></div></div>

    <div class="flex flex-1 items-center pt-6">
      <div data-rail-track class="flex items-start gap-10 px-6 will-change-transform sm:gap-16 sm:px-[max(2.5rem,calc((100vw-1400px)/2+2.5rem))]">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
        <a href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener" class="group flex h-[min(46svh,30rem)] w-[min(70vw,22rem)] shrink-0 flex-col justify-between border border-dashed border-line p-8" data-cursor="GITHUB">
          <span class="label">+ More</span>
          <span>
            <span class="display block text-3xl"><T th="ทุก repo" en="Every repo" /></span>
            <span class="mt-3 block text-lg text-muted"><T th="การทดลองและของเล่นอื่นๆ บน GitHub" en="Experiments & toys on GitHub" /></span>
          </span>
          <span class="text-3xl text-beak transition group-hover:translate-x-2">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
