---
import T from "./T.astro";
import { profile } from "../data/site.js";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<section id="contact" class="relative overflow-hidden border-t border-line">
  <div class="mx-auto max-w-[1400px] px-6 py-[20vh] text-center sm:px-10">
    <p class="label reveal mb-10 inline-flex items-center gap-4"><span class="h-px w-10 bg-beak"></span>IV — <T th="ติดต่อ" en="Contact" /><span class="h-px w-10 bg-beak"></span></p>
    <h2 class="reveal-group display text-[clamp(2.6rem,9vw,9rem)]">
      <span class="mask-reveal block"><T th="มาสร้าง" en="Let's build" /></span>
      <span class="mask-reveal block" style="--d:150ms"><span class="accent-grad"><T th="อะไร" en="something" /></span> <T th="ด้วยกัน" en="together" /></span>
    </h2>
    <p class="reveal mx-auto mt-10 max-w-lg text-xl text-muted" style="--d:300ms"><T th="มีไอเดีย งาน หรือแค่อยากทักทาย ส่งมาได้เลย" en="An idea, a job, or just a honk — my inbox is open." /></p>
    <div class="reveal mt-12 flex flex-col items-center gap-8" style="--d:400ms">
      <button type="button" data-copy-email class="btn-line !px-10 !py-6 !text-sm normal-case !tracking-[0.04em]" data-magnetic data-cursor="COPY">{profile.email}</button>
      <div class="flex gap-10">
        <a href={`mailto:${profile.email}`} class="link-line text-muted hover:text-ink" data-cursor-link><T th="ส่งอีเมล" en="Email" /> ↗</a>
        <a href={profile.github} target="_blank" rel="noopener" class="link-line text-muted hover:text-ink" data-cursor-link>GitHub ↗</a>
      </div>
    </div>
    <details class="reveal group mx-auto mt-16 max-w-xs text-sm text-muted">
      <summary class="link-line mx-auto w-max cursor-pointer list-none"><T th="เลี้ยงกาแฟห่าน · PromptPay" en="Buy the goose a coffee · PromptPay" /></summary>
      <img src={`${base}donate_qr.png`} alt="PromptPay QR" width="220" height="220" loading="lazy" class="mx-auto mt-6 w-48 bg-white p-2" />
    </details>
  </div>
</section>
